# Python (backend/, tests/)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
# Node (docs/, frontend/, e2e/)
node_modules/
dist/
.astro/
coverage/
playwright-report/
test-results/
e2e/results/
frontend/tsconfig.tsbuildinfo
# The renderer's build cache: the tree carries the pin, never the template.
.renderer-cache/
# Environment (out-of-band secrets: a committed *.env is never real)
.env
k8s/secrets/*.env
!k8s/secrets/*.env.example
# The delivery scratch's worktree mount point (committed on the line's delivery/* ref, never here).
.delivery/
