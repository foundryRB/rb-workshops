# k8s-target: namespace=rb-workshops, name=rb-workshops-renderer-source, type=Opaque
# The HTTP Basic credential of the playbook-studio door, from which the engine fetches the
# pinned renderer template. Copy to k8s/secrets/rb-workshops-renderer-source.env (git-ignored),
# fill the values, and apply with the platform's seed/apply-secrets.sh. Never commit the real file.
WORKSHOPS_RENDERER_USER=
WORKSHOPS_RENDERER_PASSWORD=
